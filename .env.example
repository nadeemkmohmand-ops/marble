# ── Supabase (leave empty to run fully offline on device storage) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Behaviour ──
# true = force login before using the app, false = open app, login optional
VITE_REQUIRE_AUTH=false

# Public URL of the deployed app (used in WhatsApp shared messages)
VITE_APP_URL=

# Company defaults (also editable inside Settings)
VITE_COMPANY_NAME=
VITE_CURRENCY=PKR
