# ── App identity ────────────────────────────────────────────────
VITE_APP_NAME="Marble Factory Management"
VITE_APP_VERSION="1.1.0"

# ── Default language ────────────────────────────────────────────
# 'ur' = Urdu (RTL, primary) | 'en' = English (LTR)
VITE_DEFAULT_LANG="ur"

# ── Data source seam (src/services/apiClient.js) ────────────────
# 'mock'  = static demo data from src/data/*        (current default)
# 'local' = future localStorage persistence
# 'api'   = real backend via src/services/apiClient.js
VITE_DATA_SOURCE="mock"

# Base URL used by apiClient when VITE_DATA_SOURCE=api
VITE_API_BASE_URL=""
